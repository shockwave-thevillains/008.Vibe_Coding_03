---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  image: { src: ImageMetadata; alt: string; credit: string; license: string; sourceUrl: string };
  priority?: boolean;
}
const { lang, image, priority = false } = Astro.props;
const t = useTranslations(lang);
---
<figure class="era-figure">
  <div class="frame">
    <Image
      src={image.src}
      alt={image.alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 64rem) 40vw, 90vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <figcaption>
    <span><span class="k">{t('era.imageCredit')}</span>{' '}{image.credit}</span>
    <span><span class="k">{t('era.imageLicense')}</span>{' '}{image.license}</span>
    <a class="link" href={image.sourceUrl} rel="noopener"><span class="k">{t('era.imageSource')}</span>{' '}↗</a>
  </figcaption>
</figure>

<style>
  .era-figure {
    display: grid;
    gap: 0.9rem;
  }
  .frame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .k {
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
