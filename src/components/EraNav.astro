---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Link {
  href: string;
  title: string;
  accent: string;
}
interface Props {
  lang: Lang;
  prev?: Link;
  next?: Link;
}
const { lang, prev, next } = Astro.props;
const t = useTranslations(lang);
---
<nav class="era-nav" aria-label={t('era.pagination')}>
  {
    prev ? (
      <a class="cell prev" href={prev.href} rel="prev" style={`--c:${prev.accent}`}>
        <span class="eyebrow">← {t('era.prev')}</span>
        <span class="name">{prev.title}</span>
      </a>
    ) : (
      <span class="cell empty" aria-hidden="true" />
    )
  }
  {
    next ? (
      <a class="cell next" href={next.href} rel="next" style={`--c:${next.accent}`}>
        <span class="eyebrow">{t('era.next')} →</span>
        <span class="name">{next.title}</span>
      </a>
    ) : (
      <span class="cell empty" aria-hidden="true" />
    )
  }
</nav>

<style>
  .era-nav {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .era-nav {
      grid-template-columns: 1fr 1fr;
    }
    .next {
      text-align: right;
      border-left: 1px solid var(--line);
    }
  }
  .cell {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.5rem, 4vw, 3rem) var(--gutter);
    border-bottom: 1px solid var(--line);
  }
  .cell::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-glow) var(--ease-expo-out);
  }
  .next::after {
    transform-origin: right;
  }
  .cell:hover::after,
  .cell:focus-visible::after {
    transform: scaleX(1);
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.05;
    transition: color var(--dur-glow) var(--ease-expo-out);
  }
  .cell:hover .name {
    color: var(--c);
  }
  .empty {
    display: none;
  }
  @media (min-width: 48rem) {
    .empty {
      display: block;
    }
  }
</style>
