---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { homeUrl, erasIndexUrl } from '../lib/url';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---
<header class="site-header">
  <div class="bar wrap">
    <a class="brand" href={homeUrl(lang)} aria-label={`${t('site.title')} — ${t('nav.home')}`}>
      <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1"></circle>
        <ellipse cx="12" cy="12" rx="4" ry="9.25" fill="none" stroke="currentColor" stroke-width="0.75"></ellipse>
        <path d="M2.75 12h18.5" stroke="currentColor" stroke-width="0.75"></path>
      </svg>
      <span>{t('site.title')}</span>
    </a>
    <nav class="nav" aria-label={t('nav.label')}>
      <a class="link nav-item" href={erasIndexUrl(lang)}>{t('nav.eras')}</a>
      <LangSwitch lang={lang} alternates={alternates} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    pointer-events: none;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }
  .bar > * {
    pointer-events: auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.01em;
    color: var(--text);
  }
  .brand-mark {
    color: var(--accent);
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--accent) 60%, transparent));
    transition: color var(--dur-accent) var(--ease-in-out);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .nav-item {
    color: var(--text-muted);
  }
  .nav-item:hover {
    color: var(--text);
  }
  @media (max-width: 30rem) {
    .brand span {
      display: none;
    }
  }
</style>
