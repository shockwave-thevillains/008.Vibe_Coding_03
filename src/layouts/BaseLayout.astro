---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { motionCssVars } from '../styles/motion';
import { langs, locales, defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { swapLang, withBase, absoluteUrl } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  accent?: string;
  /** Path padanan per bahasa (sudah dengan base). Default: tukar segmen bahasa. */
  alternates?: Record<Lang, string>;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  bodyClass?: string;
}

const {
  lang,
  title,
  description,
  accent = '#f5a25d',
  alternates: altProp,
  ogType = 'website',
  noindex = false,
  bodyClass,
} = Astro.props;
const t = useTranslations(lang);
const siteTitle = t('site.title');
const fullTitle = title ? `${title} — ${siteTitle}` : `${siteTitle} — ${t('site.tagline')}`;
const desc = description ?? t('site.description');
const pathname = Astro.url.pathname;
const alternates =
  altProp ?? (Object.fromEntries(langs.map((l) => [l, swapLang(pathname, l)])) as Record<Lang, string>);
const canonical = absoluteUrl(pathname, Astro.site);
const ogImage = absoluteUrl(withBase('og.png'), Astro.site);
const motionVars = motionCssVars();
---
<!doctype html>
<html lang={lang} style={`--accent:${accent}`} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {
      langs.map((l) => (
        <link rel="alternate" hreflang={locales[l]} href={absoluteUrl(alternates[l], Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[defaultLang], Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[lang].replace('-', '_')} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l].replace('-', '_')} />)}
    <meta name="twitter:card" content="summary_large_image" />

    <style is:inline set:html={motionVars}></style>
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t('skip.toContent')}</a>
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="ambient" aria-hidden="true" transition:name="ambient" transition:persist></div>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Inisialisasi per halaman. GSAP & three.js hanya dimuat (dynamic import) di beranda.
      let cleanup: (() => void) | undefined;
      document.addEventListener('astro:page-load', async () => {
        const root = document.querySelector<HTMLElement>('[data-home]');
        if (!root) return;
        const { initHome } = await import('../scripts/home');
        cleanup = await initHome(root);
      });
      document.addEventListener('astro:before-swap', () => {
        cleanup?.();
        cleanup = undefined;
      });
    </script>
  </body>
</html>
