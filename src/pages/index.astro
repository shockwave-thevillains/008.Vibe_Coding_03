---
import { withBase } from '../lib/url';
const target = withBase('id/');
---
<!doctype html>
<html lang="id" style="background:#000">
  <head>
    <meta charset="utf-8" />
    <title>Evolusi Dunia</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body style="background:#000;color:#edeae3;font-family:system-ui,sans-serif">
    <p><a href={target} style="color:inherit">Evolusi Dunia →</a></p>
  </body>
</html>
