---
const target = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}id/`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Evolusi Dunia</title>
  </head>
  <body style="background:#000;color:#edeae3">
    <a href={target}>Evolusi Dunia</a>
  </body>
</html>
