---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { langs, type Lang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import { getEras, eraSlug } from '../../../lib/eras';
import { eraUrl, homeUrl } from '../../../lib/url';
import { humanSpan } from '../../../lib/time';
import { pageTransition } from '../../../styles/motion';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const eras = await getEras(lang);
---
<BaseLayout lang={lang} title={t('eras.title')} description={t('eras.lead')}>
  <section class="index wrap" transition:animate={pageTransition}>
    <Breadcrumb label={t('breadcrumb.label')} items={[{ href: homeUrl(lang), label: t('nav.home') }, { label: t('eras.title') }]} />
    <h1 class="display head">{t('eras.title')}</h1>
    <p class="lead">{t('eras.lead')}</p>
    <ol class="list">
      {
        eras.map((era, i) => {
          const slug = eraSlug(era);
          return (
            <li style={`--c:${era.data.accentColor}`}>
              <a class="row" href={eraUrl(lang, slug)}>
                <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="name" transition:name={`era-title-${slug}`}>{era.data.title}</span>
                <span class="when mono">
                  {era.data.startLabel} – {era.data.endLabel}
                </span>
                <span class="span mono">≈ {humanSpan(era.data.startYearsAgo - era.data.endYearsAgo, lang)}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .index {
    padding-top: clamp(6rem, 12vw, 9rem);
    display: grid;
    gap: var(--space-m);
  }
  .head {
    font-size: var(--step-5);
    margin-top: var(--space-m);
  }
  .lead {
    max-width: 52ch;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.5;
    justify-self: end;
  }
  .list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.3rem 1.5rem;
    align-items: baseline;
    padding-block: clamp(1.1rem, 2.5vw, 1.8rem);
    border-bottom: 1px solid var(--line);
  }
  .row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-glow) var(--ease-expo-out);
  }
  .row:hover::after,
  .row:focus-visible::after {
    transform: scaleX(1);
  }
  .n {
    color: var(--text-faint);
    font-size: var(--step--1);
  }
  .name {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    transition: color var(--dur-glow) var(--ease-expo-out), text-shadow var(--dur-glow) var(--ease-expo-out);
  }
  .row:hover .name {
    color: var(--c);
    text-shadow: 0 0 0.5em color-mix(in srgb, var(--c) 40%, transparent);
  }
  .when,
  .span {
    grid-column: 2;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  @media (min-width: 60rem) {
    .row {
      grid-template-columns: 4rem 1fr 18rem 10rem;
    }
    .when,
    .span {
      grid-column: auto;
    }
    .span {
      text-align: right;
    }
  }
</style>
